# systemd user service (runs as spencer; lingering is on, so it starts at boot). README 3.14.
# Install: bash ~/Desktop/docker/dashboard/console-bridge/install.sh
# No NoNewPrivileges here on purpose: if this service starts the tmux server, the shells in it inherit
# the flag and `sudo` would stop working in the dashboard terminal.
[Unit]
Description=Terminal bridge for the dashboard

[Service]
ExecStart=/usr/bin/python3 -I %h/Desktop/docker/dashboard/console-bridge/term-bridge.py
Restart=always
RestartSec=5
# restarting the bridge must not kill a tmux server (and every shell in it) that it happened to start
KillMode=process

[Install]
WantedBy=default.target
